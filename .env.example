# Clerk Configuration
# Get these from your Clerk dashboard: https://dashboard.clerk.com
# Use these values in local development and production.

# Clerk frontend API for the browser SDK
NEXT_PUBLIC_CLERK_FRONTEND_API=https://your-clerk-subdomain.clerk.accounts.dev

# Public frontend key for Clerk client SDK
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# Secret key used on the server only
CLERK_SECRET_KEY=your_clerk_secret_key
# Razorpay Configuration
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/
# Settings > API Keys

# Public key (visible in frontend) - from Razorpay Dashboard
RAZORPAY_KEY_ID=your_key_id
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_key_id

# Secret key (KEEP SECRET - never share this, only use in backend)
# NEVER commit this to git or share with anyone
RAZORPAY_KEY_SECRET=your_key_secret

# Currency (Default is INR for India, can be changed)
NEXT_PUBLIC_CURRENCY=₹
